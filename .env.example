# Docker Compose host port overrides (JAGAPADI v3)
DB_DATABASE=jagapadi_v3
DB_USERNAME=jagapadi
DB_PASSWORD=jagapadi_secret
FORWARD_DB_PORT=5432

# Windows Hyper-V/WSL excludes TCP ports 6309-6408 on this host; map host 16379 -> container 6379
FORWARD_REDIS_PORT=16379

FORWARD_MAILPIT_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025
